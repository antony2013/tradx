NODE_ENV=development
PORT=3000
DATABASE_PATH=data/research.db

# Raw market-data capture (Upstox Feed v3). Keep disabled unless you have a
# valid access token. Never commit real tokens.
CAPTURE_ENABLED=false
UPSTOX_ACCESS_TOKEN=
UPSTOX_INSTRUMENT_KEYS=NSE_INDEX|Nifty 50
UPSTOX_FEED_MODE=ltpc
UPSTOX_AUTHORIZE_URL=https://api.upstox.com/v3/feed/market-data-feed/authorize
CAPTURE_ROOT_PATH=data/capture
CAPTURE_SCHEMA_VERSION=upstox-v3-raw-1
CAPTURE_QUEUE_CAPACITY=1000
CAPTURE_MAX_WRITE_BATCH_SIZE=100
CAPTURE_FLUSH_INTERVAL_MS=100
CAPTURE_BACKPRESSURE_TIMEOUT_MS=1000
CAPTURE_RECONNECT_MIN_MS=1000
CAPTURE_RECONNECT_MAX_MS=30000

# Historical acquisition (Upstox Candle Data V3). Reuses UPSTOX_ACCESS_TOKEN.
UPSTOX_HISTORY_BASE_URL=https://api.upstox.com/v3
HISTORICAL_SCHEMA_VERSION=upstox-v3-candles-1
HISTORICAL_MAX_RETRIES=3
HISTORICAL_INITIAL_RETRY_DELAY_MS=500
HISTORICAL_MAX_RETRY_DELAY_MS=8000
HISTORICAL_REQUEST_TIMEOUT_MS=15000
